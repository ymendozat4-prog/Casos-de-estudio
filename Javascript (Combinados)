// Caso 1: Ventas
const btnCargar1 = document.getElementById('btnCargar1');
const btnPresentar1 = document.getElementById('btnPresentar1');
const listado1 = document.getElementById('listado1');

let vectorVentas = [];
const vectorCategorias = ["Arroz", "Azúcar", "Leche", "Aceite", "Pan", "Bebidas", "Galletas"];

btnCargar1.addEventListener('click', function () {
  vectorVentas = [120, 95, 140, 170, 210, 130, 105];
  listado1.value = "Ventas cargadas correctamente.";
});

btnPresentar1.addEventListener('click', function () {
  let total = 0;
  for (let i = 0; i < vectorVentas.length; i++) total += vectorVentas[i];

  let promedio = total / vectorVentas.length;
  let superiores = 0, criticas = 0, porcentajes = [];

  for (let i = 0; i < vectorVentas.length; i++) {
    if (vectorVentas[i] > promedio) superiores++;
    if (vectorVentas[i] < 100) criticas++;
    let porcentaje = Math.round((vectorVentas[i] / total) * 1000) / 10;
    porcentajes.push(porcentaje.toFixed(1));
  }

  let salida = "Total: " + total + "\nPromedio: " + promedio.toFixed(2) + "\nSuperiores al promedio: " + superiores + "\nCríticas (<100): " + criticas + "\nPorcentajes:\n";
  for (let i = 0; i < vectorCategorias.length; i++) salida += vectorCategorias[i] + ": " + porcentajes[i] + "%\n";

  listado1.value = salida;
});

